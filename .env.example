# Copy to .env and replace the placeholder locally. Never commit an API key.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_THINKING=disabled
LLM_TEMPERATURE=0.000001

# Optional request controls
# LLM_MAX_TOKENS=512
# LLM_MAX_RPM=190

# Kimi example
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2.6
# LLM_THINKING=disabled
# LLM_TEMPERATURE=omit
